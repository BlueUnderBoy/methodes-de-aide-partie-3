<h1>
  List of all movies
</h1>

<hr>

<div>
  <%= link_to "New movie", new_movie_path %>
</div>

<hr>

<div class="row">
  <% if @movies.length > 0 %>
    <% @movies.each do |a_movie| %>
      <div class="col-md-3">
        <%= render partial: "movies/movie_card", locals: { movie: a_movie } %>
      </div>
    <% end %>
  <% end %>
</div>
