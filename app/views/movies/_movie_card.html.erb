<% if @movies.nil? %>
<div class="card">
  <div class="card-header">
    <i class="fa-regular fa-pen-to-square">It is empty</i>
  </div>
<% else %>
<div class="card">
  <div class="card-header">
    <%= link_to "Movie #{@movies.first.id}" %>
  </div>

  <div class="card-body">
    <dl>
      <dt>
        Title
      </dt>
      <dd>
        <%= @movies.first.title %>
      </dd>

      <dt>
        Description
      </dt>
      <dd>
        <%= @movies.first.description %>
      </dd>
    </dl>

    <div class="row">
      <div class="col">
        <div class="d-grid">
          <%= link_to edit_movie_path(@movies), class: "btn btn-outline-secondary" do %>
            <i class="fa-regular fa-pen-to-square"></i>
          <% end %>
        </div>
      </div>
      <div class="col">
        <div class="d-grid">
        <!--<a class="btn btn-outline-secondary" href="/movies/<%#=@movies.first.id%>" data-turbo-method=delete><i class="fa-regular fa-trash-can"></i></a>-->
          <%= link_to "/movies/#{@movies.first.id}", class: "btn btn-outline-secondary", data: { turbo_method: :delete } do %>
            <i class="fa-regular fa-trash-can"></i>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="card-footer">
    Last updated <%= time_ago_in_words(@movies.first.updated_at) %> ago
  </div>
</div>
<% end %>
